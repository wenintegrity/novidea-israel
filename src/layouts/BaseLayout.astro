---
// Page shell: <html lang/dir> from the locale, Bootstrap 5.3.9 from the CDN (RTL or LTR build),
// then the Novidea brand layer. See docs/decisions/0001-bootstrap-5-via-cdn.md.
import '@fontsource-variable/rubik';
import { getEntry } from 'astro:content';
import { ALLOW_INDEXING } from 'astro:env/server';
import '../styles/tokens.css';
import '../styles/bootstrap-brand.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { bootstrapCss, bootstrapJs, cdnOrigin } from '../config/cdn';
import { getDir, useTranslations } from '../i18n/utils';
import type { Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** URL of this page in the other locale. Omit when there's no counterpart yet. */
  alternateHref?: string;
  /** Keep this page out of search results even when indexing is on (e.g. the 404 page). */
  noindex?: boolean;
  /** Structured data (schema.org JSON-LD) for this page. */
  jsonLd?: Record<string, unknown>[];
}

const { locale, title, description, alternateHref, noindex = false, jsonLd = [] } = Astro.props;

// SEO (docs/seo.md §5). Absolute URLs come from `site` (astro.config.mjs), never a hard-coded domain.
// While ALLOW_INDEXING is off (the temporary vercel.app address), every page is noindex.
const robots = !ALLOW_INDEXING || noindex ? 'noindex' : undefined;
const path = Astro.url.pathname.replace(/\/(index\.html)?$/, '') || '/';
const canonical = noindex ? undefined : new URL(path, Astro.site).href;
const shareImage = new URL('/og/novidea-share.jpg', Astro.site).href;
const dir = getDir(locale);
const t = useTranslations(locale);
const css = bootstrapCss[dir];
const shared = await getEntry('shared', locale);
if (!shared) throw new Error(`Missing content: src/content/shared/${locale}.yaml`);
---

<!doctype html>
<html lang={locale} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    {canonical && <link rel="canonical" href={canonical} />}
    {/* Link previews (WhatsApp, LinkedIn, Facebook, X) */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t('site.name')} />
    <meta property="og:locale" content={locale === 'he' ? 'he_IL' : 'en_GB'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t('site.shareImageAlt')} />
    <meta name="twitter:card" content="summary_large_image" />
    {/* "<" escaped so text can never close the script element */}
    {
      jsonLd.map((data) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />
      ))
    }
    <meta name="theme-color" content="#101338" />
    {/* Favicons from src/assets/brand/novidea-mark-favicon.png (files in public/) */}
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href={cdnOrigin} crossorigin="anonymous" />
    {/* Bootstrap first, so the brand layer (bundled by Astro, injected after this) overrides it. */}
    <link rel="stylesheet" href={css.href} integrity={css.integrity} crossorigin="anonymous" />
    <script is:inline src={bootstrapJs.src} integrity={bootstrapJs.integrity} crossorigin="anonymous" defer
    ></script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t('skip.main')}</a>
    <ConsentBanner locale={locale} />
    <Header locale={locale} alternateHref={alternateHref} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} about={shared.data.footerAbout} />
    <script>
      import '../scripts/animate-on-scroll';
    </script>
  </body>
</html>
