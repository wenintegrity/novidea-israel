---
// Hebrew home page (/). Content: src/content/pages/he/home.yaml
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import Blocks from '../components/blocks/Blocks.astro';
import LeadCta from '../components/blocks/LeadCta.astro';
import { getLocale } from '../i18n/utils';

const locale = getLocale(Astro.currentLocale);
const page = await getEntry('pages', `${locale}/home`);
const shared = await getEntry('shared', locale);
if (!page?.data.hero) throw new Error(`Missing hero: src/content/pages/${locale}/home.yaml`);
if (!shared) throw new Error(`Missing content: src/content/shared/${locale}.yaml`);
const { seo, hero, sections, leadCta } = page.data;
---

<BaseLayout locale={locale} title={seo.title} description={seo.description}>
  <Hero {...hero} points={[]} />
  <Blocks locale={locale} blocks={sections} />
  {leadCta && <LeadCta {...shared.data.leadCta} />}
</BaseLayout>
