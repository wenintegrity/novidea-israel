---
// Hebrew internal pages (/<slug>). One page per src/content/pages/he/<slug>.yaml (except home).
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/blocks/PageHeader.astro';
import Hero from '../components/home/Hero.astro';
import Blocks from '../components/blocks/Blocks.astro';
import LeadCta from '../components/blocks/LeadCta.astro';
import { primaryNav, ctaNav, pagePath } from '../config/nav';
import { breadcrumbJsonLd } from '../config/seo';
import { useTranslations } from '../i18n/utils';

export async function getStaticPaths() {
  const pages = await getCollection('pages', (p) => p.id.startsWith('he/') && p.id !== 'he/home');
  return pages.map((page) => ({ params: { slug: page.id.slice('he/'.length) }, props: { page } }));
}

const { page } = Astro.props;
const locale = 'he' as const;
const shared = await getEntry('shared', locale);
if (!shared) throw new Error(`Missing content: src/content/shared/${locale}.yaml`);
const { seo, hero, header, sections, leadCta } = page.data;
if (!header && !hero) throw new Error(`Missing header (or hero): src/content/pages/${page.id}.yaml`);

// Breadcrumb name: the page's menu label when it has one, otherwise its h1
const t = useTranslations(locale);
const slug = page.id.slice('he/'.length);
const navItem = [...primaryNav, ctaNav].find((item) => item.slug === slug);
const pageName = navItem ? t(navItem.key) : (header?.title ?? `${hero!.titleStrong} ${hero!.titleRest}`);
const jsonLd = seo.noindex ? [] : breadcrumbJsonLd(Astro.site!, t('nav.homeShort'), pageName, pagePath(locale, slug));
---

<BaseLayout locale={locale} title={seo.title} description={seo.description} noindex={seo.noindex} jsonLd={jsonLd}>
  {hero ? <Hero {...hero} points={[]} redLine /> : header && <PageHeader {...header} />}
  <Blocks locale={locale} blocks={sections} />
  {leadCta && <LeadCta {...shared.data.leadCta} />}
</BaseLayout>
