---
// Header (docs/design-system.md §10.2): Bootstrap navbar with a responsive offcanvas (.offcanvas-lg).
// Below lg the nav opens as a panel from the inline-end side; from lg up it's inline.
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { ctaNav, homePath, isCurrent, pagePath, primaryNav } from '../config/nav';
import { useTranslations } from '../i18n/utils';
import type { Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  alternateHref?: string;
}

const { locale, alternateHref } = Astro.props;
const t = useTranslations(locale);
const otherLocale = locale === 'he' ? 'en' : 'he';
const path = Astro.url.pathname;
---

<header class="site-header sticky-top">
  <nav class="navbar navbar-expand-lg" aria-label={t('nav.label')}>
    <div class="container">
      <a class="navbar-brand" href={homePath(locale)} aria-label={t('nav.home')}>
        <Logo variant="light" decorative />
      </a>

      <button
        class="navbar-toggler"
        type="button"
        data-bs-toggle="offcanvas"
        data-bs-target="#site-nav"
        aria-controls="site-nav"
        aria-label={t('nav.open')}
      >
        <Icon name="menu" />
      </button>

      <div
        class="offcanvas offcanvas-end offcanvas-lg site-nav"
        tabindex="-1"
        id="site-nav"
        aria-labelledby="site-nav-title"
      >
        <div class="offcanvas-header">
          <h2 class="offcanvas-title h4" id="site-nav-title">{t('nav.menu')}</h2>
          <button
            type="button"
            class="btn-close btn-close-white"
            data-bs-dismiss="offcanvas"
            data-bs-target="#site-nav"
            aria-label={t('nav.close')}></button>
        </div>
        <div class="offcanvas-body">
          <ul class="navbar-nav">
            {
              primaryNav.map((item) => {
                const current = isCurrent(path, locale, item.slug);
                return (
                  <li class="nav-item">
                    <a
                      class:list={['nav-link', { active: current }]}
                      href={pagePath(locale, item.slug)}
                      aria-current={current ? 'page' : undefined}
                    >
                      {t(item.key)}
                    </a>
                  </li>
                );
              })
            }
          </ul>
          <div class="site-nav__actions">
            {
              alternateHref && (
                <a class="nav-link lang-switch" href={alternateHref} lang={otherLocale} hreflang={otherLocale}>
                  {t('lang.switch')}
                </a>
              )
            }
            <a
              class="btn btn-accent btn-sm site-nav__cta"
              href={pagePath(locale, ctaNav.slug)}
              aria-current={isCurrent(path, locale, ctaNav.slug) ? 'page' : undefined}
            >
              {t(ctaNav.key)}
            </a>
          </div>
        </div>
      </div>
    </div>
  </nav>
  {/* Reading progress (design-system.md §10.26): decorative, CSS only, no z-index of its own */}
  <div class="scroll-progress" aria-hidden="true"></div>
</header>

<style>
  .site-header {
    background-color: var(--color-white);
    border-block-end: var(--border-thin) solid var(--color-navy-200);
  }

  /* Scroll progress: a 4 px brand-red line over the header's bottom border that fills as the page
     scrolls. Scroll-driven animation (no JavaScript); browsers without support and visitors who
     prefer reduced motion don't see it. It grows in the reading direction: transform-origin has no
     logical form, so RTL gets its own (design-system.md §8.3). */
  .scroll-progress {
    display: none;
  }

  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .scroll-progress {
        display: block;
        position: absolute;
        inset-inline: 0;
        inset-block-end: calc(-1 * var(--border-thin));
        block-size: 4px;
        background-color: var(--color-red);
        transform: scaleX(0);
        transform-origin: 0 50%;
        /* Longhands on purpose: the CSS minifier folds a shorthand plus animation-timeline into one
           `animation` value, which browsers reject (the timeline isn't allowed in the shorthand) */
        animation-name: nv-scroll-progress;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll(root block);
        pointer-events: none;
      }

      .scroll-progress:dir(rtl) {
        transform-origin: 100% 50%;
      }
    }
  }

  @keyframes nv-scroll-progress {
    to {
      transform: scaleX(1);
    }
  }

  @media print {
    .scroll-progress {
      display: none !important;
    }
  }

  .navbar {
    --bs-navbar-padding-y: 0;
    --bs-navbar-color: var(--color-navy);
    --bs-navbar-hover-color: var(--color-navy);
    --bs-navbar-active-color: var(--color-navy);
    --bs-navbar-brand-color: var(--color-navy);
    --bs-navbar-brand-hover-color: var(--color-navy);
    --bs-navbar-toggler-border-color: transparent;
    --bs-navbar-toggler-padding-x: var(--space-2);
    --bs-navbar-toggler-padding-y: var(--space-2);
    min-block-size: var(--header-height);
  }

  .navbar-brand {
    padding-block: var(--space-2);
  }

  .navbar-toggler {
    min-inline-size: 2.75rem;
    min-block-size: 2.75rem;
    color: var(--color-navy);
  }

  .nav-link {
    font-size: var(--text-sm);
    font-weight: 500;
    display: flex;
    align-items: center;
    min-block-size: 2.75rem;
    border-radius: var(--radius-sm);
    transition:
      background-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .nav-link[aria-current='page'] {
    font-weight: 700;
  }

  .site-nav__actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  /* Mobile and tablet: the panel is a navy surface (Bootstrap lg breakpoint = 992px) */
  @media (max-width: 991.98px) {
    /* Only below lg: from lg up Bootstrap hides the toggler, and a display value here would override that */
    .navbar-toggler {
      display: inline-grid;
      place-items: center;
    }

    .site-nav {
      --bs-offcanvas-width: min(100vw, 22rem);
      --bs-offcanvas-bg: var(--color-navy);
      --bs-offcanvas-color: var(--color-white);
      --bs-navbar-color: var(--color-white);
      --bs-navbar-hover-color: var(--color-white);
      --bs-navbar-active-color: var(--color-white);
      --focus-ring: var(--color-yellow);
    }

    .offcanvas-title {
      margin: 0;
      color: var(--color-white);
    }

    .site-nav .nav-link {
      font-size: var(--text-h4);
      padding-inline: var(--space-4);
      border-inline-start: 4px solid transparent;
    }

    .site-nav .nav-link:hover {
      background-color: var(--color-navy-800);
    }

    /* Current page: yellow text and a yellow bar at the inline-start */
    .site-nav .nav-link[aria-current='page'] {
      color: var(--color-yellow);
      background-color: var(--color-navy-800);
      border-inline-start-color: var(--color-yellow);
    }

    .site-nav__actions {
      flex-direction: column;
      align-items: stretch;
      margin-block-start: var(--space-8);
    }

    /* The CTA becomes primary-on-dark inside the navy panel */
    .site-nav__cta {
      --bs-btn-color: var(--color-navy);
      --bs-btn-bg: var(--color-yellow);
      --bs-btn-border-color: var(--color-yellow);
      --bs-btn-hover-color: var(--color-navy);
      --bs-btn-hover-bg: var(--color-yellow-600);
      --bs-btn-hover-border-color: var(--color-yellow-600);
      min-block-size: 3rem;
    }
  }

  /* Desktop: inline nav, CTA at the inline-end */
  @media (min-width: 992px) {
    .navbar {
      --bs-navbar-nav-link-padding-x: var(--space-4);
    }

    /* The logo's wordmark sits below the middle of the logo box (the mark rises above it), so the
       menu is nudged down to line up with the wordmark rather than with the box. */
    .offcanvas-body {
      align-items: center;
      flex-grow: 1;
      position: relative;
      inset-block-start: var(--header-nav-nudge);
    }

    .navbar-nav {
      gap: var(--space-1);
      margin-inline-start: var(--space-10);
    }

    /* Hover: light navy background and a sky bar. Current page: yellow-50 background and a yellow bar. */
    .nav-link {
      box-shadow: inset 0 -3px 0 transparent;
    }

    .nav-link:hover {
      background-color: var(--color-navy-50);
      box-shadow: inset 0 -3px 0 var(--color-sky);
    }

    .nav-link[aria-current='page'] {
      background-color: var(--color-yellow-50);
      box-shadow: inset 0 -3px 0 var(--color-yellow);
    }

    .site-nav__actions {
      margin-inline-start: auto;
    }
  }
</style>
