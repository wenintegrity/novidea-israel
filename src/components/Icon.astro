---
import { directionalIcons, filledIcons, iconPaths, type IconName } from './icons';

interface Props {
  name: IconName;
  /** Accessible name. Omit for decorative icons (the default). */
  label?: string;
  class?: string;
}

const { name, label, class: className } = Astro.props;
const filled = filledIcons.has(name);
const classes = ['icon', directionalIcons.has(name) && 'icon-directional', className]
  .filter(Boolean)
  .join(' ');
---

<svg
  class={classes}
  viewBox={filled ? '0 0 16 16' : '0 0 24 24'}
  fill={filled ? 'currentColor' : 'none'}
  stroke={filled ? undefined : 'currentColor'}
  stroke-width={filled ? undefined : '1.75'}
  stroke-linecap={filled ? undefined : 'round'}
  stroke-linejoin={filled ? undefined : 'round'}
  focusable="false"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  set:html={iconPaths[name]}
/>
