---
// Footer (docs/design-system.md §10.13), navy surface.
import Logo from './Logo.astro';
import { ctaNav, homePath, pagePath, primaryNav } from '../config/nav';
import { useTranslations } from '../i18n/utils';
import type { Locale, UiKey } from '../i18n/ui';

interface Props {
  locale: Locale;
  about: string;
}

const { locale, about } = Astro.props;
const t = useTranslations(locale);
const year = new Date().getFullYear();
const links: { key: UiKey; href: string }[] = [
  { key: 'nav.homeShort', href: homePath(locale) },
  ...[...primaryNav, ctaNav].map((item) => ({ key: item.key, href: pagePath(locale, item.slug) })),
];
---

<footer class="site-footer surface-navy">
  <div class="container">
    <div class="row gy-5">
      <div class="col-12 col-lg-5">
        <a href={homePath(locale)} aria-label={t('nav.home')} class="footer-brand">
          <Logo variant="dark" decorative />
        </a>
        <p class="text-secondary-nv text-sm-nv measure mt-3 mb-0">{about}</p>
      </div>
      <nav class="col-12 col-md-6 col-lg-3 offset-lg-1" aria-labelledby="footer-nav-title">
        <h2 class="h4" id="footer-nav-title">{t('footer.navTitle')}</h2>
        <ul class="list-unstyled mb-0">
          {
            links.map((link) => (
              <li>
                <a href={link.href}>{t(link.key)}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    {/*
      TODO: legal row. Privacy policy and accessibility statement (required by law) go here once
      those pages exist (docs/sitemap.md). Not linked yet to avoid dead links.
    */}
    <div class="footer-legal text-sm-nv text-secondary-nv">
      <p class="mb-0">© <span dir="ltr">{year}</span> Novidea. {t('footer.rights')}</p>
      <button type="button" class="footer-link-button" data-consent-open>{t('footer.cookies')}</button>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-16) var(--space-8);
  }

  .footer-brand {
    display: inline-block;
    text-decoration: none;
  }

  ul a {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem;
    color: var(--color-white);
    text-decoration: none;
  }

  ul a:hover {
    text-decoration: underline;
  }

  .footer-legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-block-start: var(--space-12);
    padding-block-start: var(--space-6);
    border-block-start: var(--border-thin) solid var(--color-navy-800);
  }

  /* A button (it opens a dialog) styled as a footer link */
  .footer-link-button {
    min-block-size: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-white);
    font: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }

  .footer-link-button:hover {
    text-decoration-thickness: 2px;
  }
</style>
