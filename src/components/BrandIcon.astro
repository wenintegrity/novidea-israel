---
// Brand illustration icon (docs/design-system.md §7.4) from src/assets/icons/.
//   variant="light": navy lines, for white, light grey, yellow, sky and red surfaces
//   variant="dark":  white lines, for navy surfaces
// Icons sit next to text that says the same thing, so they're decorative (alt="").
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getEntry } from 'astro:content';

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/icons/*.png', { eager: true });

interface Props {
  id: string;
  variant?: 'light' | 'dark';
  size?: 'md' | 'lg' | 'xl';
  class?: string;
}

const { id, variant = 'light', size = 'lg', class: className } = Astro.props;

const entry = await getEntry('icons', id);
if (!entry) throw new Error(`Unknown icon "${id}". Add src/assets/icons/${id}.png and run "npm run icons".`);

const fileName = variant === 'dark' ? `${id}.on-dark.png` : `${id}.png`;
const file = files[`../assets/icons/${fileName}`];
if (!file) {
  throw new Error(`Icon "${id}" has no ${variant} version. Add src/assets/icons/${fileName} and run "npm run icons".`);
}

const px = { md: 32, lg: 48, xl: 64 }[size];
---

<Image
  src={file.default}
  alt=""
  width={px}
  height={px}
  densities={[1, 2]}
  class:list={['brand-icon', { 'icon-directional': entry.data.directional }, className]}
/>

<style>
  .brand-icon {
    display: block;
    flex-shrink: 0;
  }
</style>
