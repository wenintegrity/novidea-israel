---
// Product spotlight (docs/design-system.md §10.14): text at the inline-start, product image at the
// inline-end. Stacks on mobile and tablet.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from '../Icon.astro';

interface Props {
  eyebrow: string;
  title: string;
  body: string;
  points: string[];
  picture?: { src: ImageMetadata; alt: string };
}

const { eyebrow, title, body, points, picture } = Astro.props;
---

<section id="customer-view" tabindex="-1" class="section surface-subtle" aria-labelledby="spotlight-title">
  <div class="container">
    <div class="row gy-5 align-items-center">
      <div class="col-12 col-lg-5" data-animate="fade-start">
        <span class="eyebrow">{eyebrow}</span>
        <h2 id="spotlight-title">{title}</h2>
        <p class="lead-nv">{body}</p>
        <ul class="list-unstyled d-grid gap-3 mb-0">
          {
            points.map((point) => (
              <li class="d-flex align-items-center gap-3">
                <Icon name="check" class="spotlight__check" />
                <span>{point}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="col-12 col-lg-6 offset-lg-1" data-animate="fade-end" data-animate-delay="0.1">
        {
          picture ? (
            <Image
              src={picture.src}
              alt={picture.alt}
              widths={[480, 720, 960]}
              sizes="(min-width: 992px) 45vw, 100vw"
              loading="lazy"
              class="spotlight__picture"
            />
          ) : (
            /* Placeholder until a product picture is set in home.yaml. Decorative. */
            <div class="screen" aria-hidden="true">
              <div class="screen__bar">
                <span />
                <span />
                <span />
              </div>
              <div class="screen__body">
                <div class="screen__card screen__card--profile" />
                <div class="screen__card" />
                <div class="screen__card" />
                <div class="screen__card screen__card--wide" />
              </div>
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .eyebrow {
    color: var(--color-navy);
  }

  section :global(.spotlight__check) {
    padding: 0.2rem;
    border-radius: var(--radius-full);
    background-color: var(--color-yellow);
    color: var(--color-navy);
  }

  .spotlight__picture {
    display: block;
    inline-size: 100%;
    block-size: auto;
    box-shadow: var(--shadow-md);
  }

  .screen {
    border: var(--border-thin) solid var(--color-navy-200);
    background-color: var(--color-white);
    box-shadow: var(--shadow-md);
  }

  .screen__bar {
    display: flex;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    background-color: var(--color-navy);
  }

  .screen__bar span {
    inline-size: 0.5rem;
    block-size: 0.5rem;
    border-radius: var(--radius-full);
    background-color: var(--color-navy-muted);
  }

  .screen__body {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
    padding: var(--space-4);
    aspect-ratio: 4 / 3;
  }

  .screen__card {
    background-color: var(--color-navy-50);
    border-block-start: 3px solid var(--color-sky);
  }

  .screen__card--profile {
    grid-row: span 2;
    border-block-start-color: var(--color-yellow);
  }

  .screen__card--wide {
    grid-column: span 2;
    border-block-start-color: var(--color-red);
  }
</style>
