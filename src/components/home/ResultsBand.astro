---
// Results band (docs/design-system.md §10.18): the brand ads' red panel with checkmarked areas.
// Red surface, navy text only (white on red fails contrast). Slanted inline-end edge from md up.
import Icon from '../Icon.astro';

interface Props {
  title: string;
  items: string[];
}

const { title, items } = Astro.props;
---

<section class="section surface-light" aria-labelledby="results-title">
  <div class="container">
    <div class="results surface-red" data-animate="fade-start">
      <h2 id="results-title" class="h3 results__title">{title}</h2>
      <ul
        class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-3 list-unstyled mb-0"
        data-animate-children="fade-up"
        data-animate-delay="0.25"
      >
        {
          items.map((item) => (
            <li class="col results__item">
              <Icon name="check" class="results__check" />
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .results {
    padding: var(--space-8) var(--space-6);
  }

  .results__title {
    margin-block-end: var(--space-6);
  }

  .results__item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-weight: 600;
  }

  .results :global(.results__check) {
    padding: 0.2rem;
    border-radius: var(--radius-full);
    background-color: var(--color-navy);
    color: var(--color-white);
  }

  @media (min-width: 768px) {
    .results {
      padding-block: var(--space-12);
      padding-inline: var(--space-12) calc(var(--space-12) + var(--slant));
      /* Slanted inline-end edge (design-system.md §7.1, physical exception §8.3) */
      clip-path: polygon(0 0, 100% 0, calc(100% - var(--slant)) 100%, 0 100%);
    }

    .results:dir(rtl) {
      clip-path: polygon(0 0, 100% 0, 100% 100%, var(--slant) 100%);
    }
  }
</style>
