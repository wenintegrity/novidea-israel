---
// Audience tiles (docs/design-system.md §10.7): flat brand-colored tiles. 1 column on mobile,
// 2 on tablet, 4 on desktop. When a tile has a link, the whole tile is one link (stretched ::after).
import Icon from '../Icon.astro';
import BrandIcon from '../BrandIcon.astro';

interface Item {
  icon?: { id: string };
  title: string;
  body: string;
  href?: string;
}

interface Props {
  title: string;
  items: Item[];
}

const { title, items } = Astro.props;
const surfaces = ['sky', 'red', 'navy', 'yellow'] as const;
---

<section id="audiences" tabindex="-1" class="section surface-light" aria-labelledby="audiences-title">
  <div class="container">
    <header class="section-header" data-animate="fade-up">
      <h2 id="audiences-title">{title}</h2>
    </header>
    <ul class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-3 list-unstyled mb-0" data-animate-children="fade-up">
      {
        items.map((item, i) => {
          const surface = surfaces[i % surfaces.length];
          return (
          <li class="col">
            <div class:list={['tile', `surface-${surface}`, { 'tile--link': item.href }]}>
              {item.icon && (
                <BrandIcon id={item.icon.id} variant={surface === 'navy' ? 'dark' : 'light'} size="xl" />
              )}
              <h3 class="tile__title caps">
                {item.href ? (
                  <a class="stretched-link" href={item.href}>
                    {item.title}
                  </a>
                ) : (
                  item.title
                )}
              </h3>
              <p class="mb-0">{item.body}</p>
              {item.href && <Icon name="arrow" class="tile__arrow" />}
            </div>
          </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    block-size: 100%;
    min-block-size: 12rem;
    padding: var(--space-6);
    transition:
      box-shadow var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-out);
  }

  /* Lift only when the tile is a link: a lift on a static tile would suggest it's clickable */
  .tile--link:hover {
    transform: translateY(-4px);
  }

  .tile__title {
    margin: 0;
  }

  .tile__title a {
    color: inherit;
    text-decoration: none;
  }

  .tile--link:hover {
    box-shadow: var(--shadow-md);
  }

  .tile--link:focus-within {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }

  .tile--link :global(a:focus-visible) {
    outline: none;
  }

  .tile :global(.tile__arrow) {
    margin-block-start: auto;
  }
</style>
