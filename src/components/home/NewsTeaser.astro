---
// News teaser (docs/design-system.md §10.16). Items link to blog posts once the blog exists.
import { formatDate, isoDate } from '../../i18n/utils';
import type { Locale } from '../../i18n/ui';

interface Item {
  date: Date;
  title: string;
  summary: string;
  href?: string;
}

interface Props {
  locale: Locale;
  title: string;
  items: Item[];
}

const { locale, title, items } = Astro.props;
const sorted = [...items].sort((a, b) => b.date.getTime() - a.date.getTime());
---

<section id="news" tabindex="-1" class="section surface-light" aria-labelledby="news-title">
  <div class="container">
    <header class="section-header" data-animate="fade-up">
      <h2 id="news-title">{title}</h2>
    </header>
    <ul class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 list-unstyled mb-0" data-animate-children="fade-up">
      {
        sorted.map((item) => (
          <li class="col">
            <article class="news-card">
              <time class="news-card__date" datetime={isoDate(item.date)}>
                <span dir="ltr">{formatDate(item.date, locale)}</span>
              </time>
              <h3 class="h4 news-card__title">
                {item.href ? <a href={item.href}>{item.title}</a> : item.title}
              </h3>
              <p class="mb-0 text-secondary-nv">{item.summary}</p>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .news-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    block-size: 100%;
    padding: var(--space-6);
    border: var(--border-thin) solid var(--color-navy-200);
    border-block-start: 4px solid var(--color-sky);
  }

  .news-card__date {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    order: -1;
  }

  .news-card__title {
    margin: 0;
  }
</style>
