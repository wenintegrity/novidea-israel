---
// Customer story (docs/design-system.md §10.15): summary and outcomes at the inline-start,
// customer quote at the inline-end. Tint surface.
import Icon from '../Icon.astro';

interface Props {
  eyebrow: string;
  title: string;
  body: string;
  points: string[];
  quote: { text: string; name: string; role: string };
  href?: string;
}

const { eyebrow, title, body, points, quote, href } = Astro.props;
---

<section id="customer-story" tabindex="-1" class="section surface-tint" aria-labelledby="story-title">
  <div class="container">
    <div class="row gy-5">
      <div class="col-12 col-lg-6" data-animate="fade-up">
        <span class="eyebrow">{eyebrow}</span>
        <h2 id="story-title">{href ? <a href={href}>{title}</a> : title}</h2>
        <p>{body}</p>
        <ul class="list-unstyled d-grid gap-3 mb-0">
          {
            points.map((point) => (
              <li class="d-flex align-items-center gap-3">
                <Icon name="check" class="story__check" />
                <span>{point}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <figure class="col-12 col-lg-5 offset-lg-1 mb-0 story__quote" data-animate="fade-up" data-animate-delay="0.15">
        <blockquote class="mb-0">
          <p>{quote.text}</p>
        </blockquote>
        <figcaption>
          <span class="story__name">{quote.name}</span>
          <span class="story__role">{quote.role}</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  section :global(.story__check) {
    padding: 0.2rem;
    border-radius: var(--radius-full);
    background-color: var(--color-navy);
    color: var(--color-white);
  }

  .story__quote {
    align-self: center;
    padding-inline-start: var(--space-6);
    border-inline-start: 4px solid var(--color-yellow);
  }

  blockquote p {
    font-size: var(--text-h3);
    line-height: var(--leading-h3);
    font-weight: 500;
    margin-block-end: var(--space-6);
  }

  blockquote p::before {
    content: open-quote;
  }

  blockquote p::after {
    content: close-quote;
  }

  /* Hebrew uses straight double quotes on screen ("…"); English uses curly quotes. */
  :global(:lang(he)) blockquote p {
    quotes: '"' '"';
  }

  :global(:lang(en)) blockquote p {
    quotes: '\201C' '\201D';
  }

  figcaption {
    display: grid;
  }

  .story__name {
    font-weight: 700;
  }

  .story__role {
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }
</style>
