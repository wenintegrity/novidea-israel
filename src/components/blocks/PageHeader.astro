---
// Internal page header (docs/design-system.md §10.19): eyebrow, h1, intro paragraphs, optional picture.
// Subtle surface. Text at the inline-start, picture at the inline-end from lg up; stacked below lg.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow?: string;
  title: string;
  intro: string[];
  picture?: { src: ImageMetadata; alt: string };
}

const { eyebrow, title, intro, picture } = Astro.props;
---

<section class="page-header surface-subtle" aria-labelledby="page-title">
  <div class="container">
    <div class="row gy-5 align-items-center">
      <div class:list={['col-12', { 'col-lg-6': picture, 'col-lg-9': !picture }]}>
        <div class="page-header__text">
          {eyebrow && <span class="eyebrow">{eyebrow}</span>}
          <h1 id="page-title">{title}</h1>
          {intro.map((p) => <p class="lead-nv">{p}</p>)}
        </div>
      </div>
      {
        picture && (
          <div class="col-12 col-lg-5 offset-lg-1">
            <Image
              src={picture.src}
              alt={picture.alt}
              widths={[480, 720, 960]}
              sizes="(min-width: 992px) 40vw, 100vw"
              loading="eager"
              fetchpriority="high"
              class="page-header__picture"
            />
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .page-header {
    padding-block: var(--space-12) var(--section-pad);
  }

  /* Load entrance, same as the home hero */
  .page-header__text > * {
    animation: nv-enter-up 0.7s var(--ease-out) both;
  }

  .page-header__text > :nth-child(2) { animation-delay: 0.08s; }
  .page-header__text > :nth-child(3) { animation-delay: 0.16s; }
  .page-header__text > :nth-child(4) { animation-delay: 0.24s; }

  .page-header__text > :last-child {
    margin-block-end: 0;
  }

  h1 {
    margin-block-end: var(--space-4);
  }

  .page-header__picture {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }
</style>
