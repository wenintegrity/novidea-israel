---
// Text block (docs/content-model.md → Blocks): optional title, paragraphs, and an optional picture
// or video beside them.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Video from '../Video.astro';
import type { Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
  id?: string;
  title?: string;
  paragraphs: string[];
  picture?: { src: ImageMetadata; alt: string };
  video?: { file?: string; title: string; captions?: string; poster?: ImageMetadata };
  surface: 'light' | 'subtle' | 'tint' | 'navy';
}

const { locale, id, title, paragraphs, picture, video, surface } = Astro.props;
const media = Boolean(picture || video);
const headingId = id ? `${id}-title` : undefined;
---

<section
  id={id}
  tabindex={id ? '-1' : undefined}
  class:list={['section', `surface-${surface}`]}
  aria-labelledby={title ? headingId : undefined}
>
  <div class="container">
    {/* A video gets 7 of 12 columns (text 5) so the player is large enough to watch; a picture gets 5 */}
    <div class:list={['row gy-5 align-items-center', { 'gx-lg-5': video }]}>
      <div
        class:list={['col-12', { 'col-lg-5': video, 'col-lg-6': picture, 'col-lg-9': !media }]}
        data-animate="fade-up"
      >
        {title && <h2 id={headingId} class="title-accent">{title}</h2>}
        {paragraphs.map((p, i) => <p class:list={{ 'lead-nv': i === 0 }}>{p}</p>)}
      </div>
      {
        picture && (
          <div class="col-12 col-lg-5 offset-lg-1" data-animate="fade-end" data-animate-delay="0.1">
            <Image
              src={picture.src}
              alt={picture.alt}
              widths={[480, 720, 960]}
              sizes="(min-width: 992px) 40vw, 100vw"
              loading="lazy"
              class="text-block__picture"
            />
          </div>
        )
      }
      {
        video && (
          <div class="col-12 col-lg-7" data-animate="fade-end" data-animate-delay="0.1">
            <div class="text-block__video">
              <Video locale={locale} {...video} />
            </div>
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  p:last-child {
    margin-block-end: 0;
  }

  /* Same gap under the title bar as the other titled sections (32 px) */
  h2 {
    margin-block-end: var(--space-8);
  }

  /* Desktop: the player fills 88% of its column, aligned to the page edge (inline-end) */
  @media (min-width: 992px) {
    .text-block__video {
      max-inline-size: 88%;
      margin-inline-start: auto;
    }
  }

  .text-block__picture {
    display: block;
    inline-size: 100%;
    block-size: auto;
    box-shadow: var(--shadow-md);
  }
</style>
