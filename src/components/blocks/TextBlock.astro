---
// Text block (docs/content-model.md → Blocks): optional title, paragraphs, optional picture.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  id?: string;
  title?: string;
  paragraphs: string[];
  picture?: { src: ImageMetadata; alt: string };
  surface: 'light' | 'subtle' | 'tint' | 'navy';
}

const { id, title, paragraphs, picture, surface } = Astro.props;
const headingId = id ? `${id}-title` : undefined;
---

<section
  id={id}
  tabindex={id ? '-1' : undefined}
  class:list={['section', `surface-${surface}`]}
  aria-labelledby={title ? headingId : undefined}
>
  <div class="container">
    <div class="row gy-5 align-items-center">
      <div class:list={['col-12', { 'col-lg-6': picture, 'col-lg-9': !picture }]} data-animate="fade-up">
        {title && <h2 id={headingId} class="title-accent">{title}</h2>}
        {paragraphs.map((p, i) => <p class:list={{ 'lead-nv': i === 0 }}>{p}</p>)}
      </div>
      {
        picture && (
          <div class="col-12 col-lg-5 offset-lg-1" data-animate="fade-end" data-animate-delay="0.1">
            <Image
              src={picture.src}
              alt={picture.alt}
              widths={[480, 720, 960]}
              sizes="(min-width: 992px) 40vw, 100vw"
              loading="lazy"
              class="text-block__picture"
            />
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  p:last-child {
    margin-block-end: 0;
  }

  .text-block__picture {
    display: block;
    inline-size: 100%;
    block-size: auto;
    box-shadow: var(--shadow-md);
  }

  /* On navy the picture's own navy background merges with the section: no shadow, no visible edge */
  .surface-navy .text-block__picture {
    box-shadow: none;
  }
</style>
