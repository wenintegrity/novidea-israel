---
// Customer names (docs/design-system.md §10.10). Names render as text until logo files exist.
interface Props {
  id?: string;
  title: string;
  names: string[];
  more?: string;
  surface: 'light' | 'subtle' | 'tint' | 'navy';
}

const { id, title, names, more, surface } = Astro.props;
const headingId = `${id ?? 'names'}-title`;
---

<section id={id} tabindex={id ? '-1' : undefined} class:list={['section', `surface-${surface}`]} aria-labelledby={headingId}>
  <div class="container">
    <header class="section-header" data-animate="fade-up">
      <h2 id={headingId}>{title}</h2>
    </header>
    <ul class="names list-unstyled mb-0" data-animate-children="fade-in">
      {names.map((name) => <li class="name">{name}</li>)}
      {more && <li class="name name--more">{more}</li>}
    </ul>
  </div>
</section>

<style>
  .names {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
  }

  .name {
    display: grid;
    place-items: center;
    min-block-size: 5rem;
    padding: var(--space-3);
    background-color: var(--color-white);
    border: var(--border-thin) solid var(--color-navy-200);
    text-align: center;
    font-size: var(--text-h4);
    font-weight: 700;
  }

  .name--more {
    background-color: transparent;
    border-style: dashed;
    font-weight: 500;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .names {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
