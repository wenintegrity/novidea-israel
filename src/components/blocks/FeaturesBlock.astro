---
// Feature items (docs/design-system.md §10.8): brand icon, title, body, and "coming soon" labels.
// 1 column on mobile, 2 on tablet, 2 or 3 on desktop. Item headings are h3 under a block title,
// h2 when the block has none (keeps the heading order intact).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BrandIcon from '../BrandIcon.astro';
import { useTranslations } from '../../i18n/utils';
import type { Locale } from '../../i18n/ui';

interface Item {
  icon?: { id: string };
  title?: string;
  body?: string;
  soon: boolean;
  soonNote?: string;
}

interface Props {
  locale: Locale;
  id?: string;
  title?: string;
  intro?: string;
  columns: 2 | 3;
  surface: 'light' | 'subtle' | 'tint' | 'navy';
  picture?: { src: ImageMetadata; alt: string };
  items: Item[];
}

const { locale, id, title, intro, columns, surface, picture, items } = Astro.props;
const t = useTranslations(locale);
const headingId = id ? `${id}-title` : undefined;
const ItemHeading = title ? 'h3' : 'h2';
const iconVariant = surface === 'navy' ? 'dark' : 'light';
---

<section
  id={id}
  tabindex={id ? '-1' : undefined}
  class:list={['section', `surface-${surface}`]}
  aria-labelledby={title ? headingId : undefined}
>
  <div class="container">
    {
      (title || intro || picture) && (
        <div class="row gy-4 align-items-center section-header">
          <header class:list={['col-12', { 'col-lg-6': picture }]}>
            <div class="measure" data-animate="fade-up">
              {title && <h2 id={headingId}>{title}</h2>}
              {intro && <p class="lead-nv text-secondary-nv mb-0">{intro}</p>}
            </div>
          </header>
          {picture && (
            <div class="col-12 col-lg-5 offset-lg-1" data-animate="zoom-in" data-animate-delay="0.1">
              <Image
                src={picture.src}
                alt={picture.alt}
                widths={[480, 720, 960]}
                sizes="(min-width: 992px) 40vw, 100vw"
                class="section-picture"
                loading="lazy"
              />
            </div>
          )}
        </div>
      )
    }
    {/* gx-4 matches the container padding; a larger horizontal gutter overflows on mobile */}
    <ul
      class:list={['row row-cols-1 row-cols-md-2 gx-4 gy-5 list-unstyled mb-0', { 'row-cols-lg-3': columns === 3 }]}
      data-animate-children="fade-up"
    >
      {
        items.map((item) => (
          <li class="col feature">
            {item.icon && <BrandIcon id={item.icon.id} variant={iconVariant} size="xl" class="feature-icon" />}
            {item.soon && <span class="badge-soon">{t('badge.soon')}</span>}
            {item.title && <ItemHeading class="h4 feature__title">{item.title}</ItemHeading>}
            {item.body && <p class="text-secondary-nv mb-0">{item.body}</p>}
            {item.soonNote && (
              <p class="feature__soon mb-0">
                <span class="badge-soon">{t('badge.soon')}</span> {item.soonNote}
              </p>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .feature__title {
    margin-block-end: var(--space-2);
  }

  li :global(.feature-icon) {
    margin-block-end: var(--space-4);
    transition: transform var(--duration-base) var(--ease-out);
  }

  li:hover :global(.feature-icon) {
    transform: scale(1.08);
  }

  .badge-soon {
    display: inline-block;
    margin-block-end: var(--space-2);
    padding: 0 var(--space-2);
    background-color: var(--color-yellow);
    color: var(--color-navy);
    font-size: var(--text-xs);
    font-weight: 600;
    line-height: 1.8;
  }

  .feature__soon {
    margin-block-start: var(--space-3);
    font-size: var(--text-sm);
  }

  .feature__soon .badge-soon {
    margin-block-end: 0;
    margin-inline-end: var(--space-1);
  }

  .section-picture {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }
</style>
