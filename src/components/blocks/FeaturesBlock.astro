---
// Feature cards (docs/design-system.md §10.8): brand icon, title, body, and "coming soon" labels.
// 1 column on mobile, 2 on tablet, 2 or 3 on desktop. Rows of cards alternate between two
// background colors, picked from the section surface. Item headings are h3 under a block title,
// h2 when the block has none (keeps the heading order intact).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BrandIcon from '../BrandIcon.astro';
import Icon from '../Icon.astro';
import { useTranslations } from '../../i18n/utils';
import type { Locale } from '../../i18n/ui';

interface Item {
  icon?: { id: string };
  title?: string;
  body?: string;
  soon: boolean;
  soonNote?: string;
}

interface Props {
  locale: Locale;
  id?: string;
  title?: string;
  intro?: string;
  columns: 2 | 3;
  surface: 'light' | 'subtle' | 'tint' | 'navy';
  picture?: { src: ImageMetadata; alt: string };
  items: Item[];
}

const { locale, id, title, intro, columns, surface, picture, items } = Astro.props;
const t = useTranslations(locale);
const headingId = id ? `${id}-title` : undefined;
const ItemHeading = title ? 'h3' : 'h2';
const iconVariant = surface === 'navy' ? 'dark' : 'light';
---

<section
  id={id}
  tabindex={id ? '-1' : undefined}
  class:list={['section', `surface-${surface}`]}
  aria-labelledby={title ? headingId : undefined}
>
  <div class="container">
    {
      (title || intro || picture) && (
        <div class="row gy-4 align-items-center section-header">
          <header class:list={['col-12', { 'col-lg-6': picture }]}>
            <div class="measure" data-animate="fade-up">
              {title && <h2 id={headingId} class="title-accent">{title}</h2>}
              {intro && <p class="lead-nv text-secondary-nv mb-0">{intro}</p>}
            </div>
          </header>
          {picture && (
            <div class="col-12 col-lg-5 offset-lg-1" data-animate="zoom-in" data-animate-delay="0.1">
              <Image
                src={picture.src}
                alt={picture.alt}
                widths={[480, 720, 960]}
                sizes="(min-width: 992px) 40vw, 100vw"
                class="section-picture"
                loading="lazy"
              />
            </div>
          )}
        </div>
      )
    }
    {/* gx-4 matches the container padding; a larger horizontal gutter overflows on mobile */}
    <ul
      class:list={[
        'features row row-cols-1 row-cols-md-2 gx-4 gy-4 list-unstyled mb-0',
        { 'row-cols-lg-3 features--3': columns === 3 },
      ]}
      data-animate-children="fade-up"
    >
      {
        items.map((item) => (
          <li class="col">
            <div class="feature-card">
              {item.icon && <BrandIcon id={item.icon.id} variant={iconVariant} size="xl" class="feature-icon" />}
              {item.soon && (
                <span class="badge-soon">
                  <Icon name="rocket" class="badge-soon__icon" />
                  {t('badge.soon')}
                </span>
              )}
              {item.title && <ItemHeading class="h4 feature__title">{item.title}</ItemHeading>}
              {item.body && <p class="feature__body mb-0">{item.body}</p>}
              {item.soonNote && (
                <p class="feature__soon mb-0">
                  <span class="badge-soon">
                    <Icon name="rocket" class="badge-soon__icon" />
                    {t('badge.soon')}
                  </span>{' '}
                  {item.soonNote}
                </p>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* Row colors per surface: A for odd rows, B for even rows (design-system.md §10.8) */
  .section {
    --card-a: var(--color-navy-50);
    --card-b: var(--color-yellow-50);
  }

  .surface-subtle {
    --card-a: var(--color-white);
    --card-b: var(--color-yellow-50);
  }

  .surface-tint {
    --card-a: var(--color-white);
    --card-b: var(--color-navy-50);
  }

  .surface-navy {
    --card-a: var(--color-navy-800);
    --card-b: rgb(255 255 255 / 0.1);
  }

  .feature-card {
    block-size: 100%;
    padding: var(--space-6);
    background-color: var(--card-bg, var(--card-a));
    border-radius: var(--radius-sm);
  }

  /* Even rows. One column below md: every second card */
  .features > li:nth-child(even) .feature-card {
    --card-bg: var(--card-b);
  }

  /* Two columns from md: cards 3-4, 7-8, ... */
  @media (min-width: 768px) {
    .features > li:nth-child(even) .feature-card {
      --card-bg: var(--card-a);
    }

    .features > li:nth-child(4n + 3) .feature-card,
    .features > li:nth-child(4n + 4) .feature-card {
      --card-bg: var(--card-b);
    }
  }

  /* Three columns from lg: cards 4-6, 10-12, ... */
  @media (min-width: 992px) {
    .features--3 > li:nth-child(n) .feature-card {
      --card-bg: var(--card-a);
    }

    .features--3 > li:nth-child(6n + 4) .feature-card,
    .features--3 > li:nth-child(6n + 5) .feature-card,
    .features--3 > li:nth-child(6n + 6) .feature-card {
      --card-bg: var(--card-b);
    }
  }

  .feature__title {
    margin-block-end: var(--space-2);
  }

  .feature__body {
    color: var(--text-secondary);
  }

  .surface-navy .feature__body {
    color: var(--color-navy-muted);
  }

  .feature-card :global(.feature-icon) {
    margin-block-end: var(--space-4);
    transition: transform var(--duration-base) var(--ease-out);
  }

  .feature-card:hover :global(.feature-icon) {
    transform: scale(1.08);
  }

  /* "בקרוב" label with a small rocket (Bootstrap Icons). The icon is 1em, set inline the way Bootstrap
     sets icons in text (vertical-align -0.125em), so neither the label nor its line changes size. */
  .badge-soon {
    display: inline-block;
    margin-block-end: var(--space-2);
    padding: 0 var(--space-2);
    background-color: var(--color-yellow);
    color: var(--color-navy);
    font-size: var(--text-xs);
    font-weight: 600;
    line-height: 1.8;
  }

  .badge-soon :global(.badge-soon__icon) {
    display: inline-block;
    inline-size: 1em;
    block-size: 1em;
    margin-inline-end: 0.3em;
    vertical-align: -0.125em;
  }

  .feature__soon {
    margin-block-start: var(--space-3);
    font-size: var(--text-sm);
  }

  .feature__soon .badge-soon {
    margin-block-end: 0;
    margin-inline-end: var(--space-1);
  }

  .section-picture {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }
</style>
