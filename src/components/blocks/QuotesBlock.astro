---
// Customer quotes carousel (docs/design-system.md §10.25). Bootstrap 5 carousel (data API, JS from the
// CDN bundle), cross-fade, no autoplay: visitors move between quotes with the arrow buttons, the dots
// or the keyboard arrows. All slides share one grid cell, so the carousel is as tall as the longest
// quote and doesn't jump. Quotation marks come from CSS `quotes`, not the content.
import Icon from '../Icon.astro';
import { useTranslations } from '../../i18n/utils';
import type { Locale } from '../../i18n/ui';

interface Quote {
  quote: string;
  name: string;
  role: string;
  company: string;
}

interface Props {
  locale: Locale;
  id?: string;
  title: string;
  surface: 'light' | 'subtle' | 'tint' | 'navy';
  items: Quote[];
}

const { locale, id = 'quotes', title, surface, items } = Astro.props;
const t = useTranslations(locale);
const carouselId = `${id}-carousel`;
const headingId = `${id}-title`;
const fill = (text: string, n: number) => text.replace('{n}', String(n)).replace('{total}', String(items.length));
---

<section id={id} tabindex="-1" class:list={['section', `surface-${surface}`]} aria-labelledby={headingId}>
  <div class="container">
    <header class="section-header" data-animate="fade-up">
      <h2 id={headingId} class="title-accent">{title}</h2>
    </header>

    <div
      id={carouselId}
      class="carousel slide carousel-fade quotes"
      aria-roledescription={t('quotes.carousel')}
      aria-labelledby={headingId}
      data-animate="fade-up"
    >
      <div class="carousel-inner" aria-live="polite">
        {
          items.map((item, i) => (
            <div
              class:list={['carousel-item', { active: i === 0 }]}
              role="group"
              aria-roledescription={t('quotes.slide')}
              aria-label={fill(t('quotes.position'), i + 1)}
            >
              <figure class="quote mb-0">
                <span class="quote__mark" aria-hidden="true" />
                <blockquote class="quote__text">
                  <p>{item.quote}</p>
                </blockquote>
                <figcaption class="quote__by">
                  <span class="quote__name">{item.name}</span>
                  <span class="quote__role">
                    {/* A middle dot, not a comma: it reads right whichever language each part is in */}
                    <bdi>{item.role}</bdi> · <bdi>{item.company}</bdi>
                  </span>
                </figcaption>
              </figure>
            </div>
          ))
        }
      </div>

      <div class="quotes__controls">
        <button type="button" class="quotes__arrow" data-bs-target={`#${carouselId}`} data-bs-slide="prev">
          <span class="quotes__prev-icon"><Icon name="arrow" /></span>
          <span class="visually-hidden">{t('quotes.prev')}</span>
        </button>
        <div class="carousel-indicators quotes__dots">
          {
            items.map((item, i) => (
              <button
                type="button"
                data-bs-target={`#${carouselId}`}
                data-bs-slide-to={i}
                class:list={{ active: i === 0 }}
                aria-current={i === 0 ? 'true' : undefined}
                aria-label={`${fill(t('quotes.position'), i + 1)}: ${item.name}`}
              />
            ))
          }
        </div>
        <button type="button" class="quotes__arrow" data-bs-target={`#${carouselId}`} data-bs-slide="next">
          <Icon name="arrow" />
          <span class="visually-hidden">{t('quotes.next')}</span>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .quotes {
    max-inline-size: 56rem;
  }

  /* One grid cell for every slide: the tallest quote sets the height, so nothing jumps */
  .carousel-inner {
    display: grid;
  }

  .carousel-item {
    display: block;
    grid-area: 1 / 1;
    margin: 0;
    float: none;
    visibility: hidden;
  }

  .carousel-item.active,
  .carousel-item-next,
  .carousel-item-prev {
    visibility: visible;
  }

  .quote {
    display: grid;
    gap: var(--space-6);
  }

  .quote__mark::before {
    content: '\201D';
    display: block;
    block-size: 2.5rem;
    color: var(--color-yellow);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 6rem;
    line-height: 1;
  }

  .quote__text {
    margin: 0;
    font-size: var(--text-h4);
    line-height: 1.6;
    font-weight: 400;
  }

  :lang(he) .quote__text {
    quotes: '"' '"';
  }

  .quote__text p {
    margin: 0;
  }

  .quote__text p::before {
    content: open-quote;
  }

  .quote__text p::after {
    content: close-quote;
  }

  .quote__by {
    display: grid;
    gap: var(--space-1);
    padding-inline-start: var(--space-4);
    border-inline-start: 4px solid var(--color-yellow);
  }

  .quote__name {
    font-weight: 700;
  }

  .quote__role {
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  /* Controls under the quote: previous · dots · next */
  .quotes__controls {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-block-start: var(--space-10);
  }

  .quotes__arrow {
    display: inline-grid;
    place-items: center;
    inline-size: 3rem;
    block-size: 3rem;
    padding: 0;
    border: 2px solid currentColor;
    border-radius: var(--radius-full);
    background: transparent;
    color: inherit;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .quotes__arrow:hover {
    background-color: var(--color-yellow);
    border-color: var(--color-yellow);
    color: var(--color-navy);
  }

  .quotes__arrow:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }

  /* "Previous" points back, against the reading direction. `rotate` leaves the RTL mirroring
     (`transform` on .icon-directional) untouched. */
  .quotes__prev-icon {
    display: inline-grid;
    rotate: 180deg;
  }

  /* Bootstrap positions .carousel-indicators over the slides; here they sit between the arrows */
  .quotes__dots {
    position: static;
    margin: 0;
    padding: 0;
    gap: var(--space-1);
  }

  /* 24 px targets with a 10 px dot inside (Bootstrap's own indicator styles are reset) */
  .quotes__dots [data-bs-slide-to] {
    box-sizing: border-box;
    inline-size: 1.5rem;
    block-size: 1.5rem;
    margin: 0;
    padding: 0;
    border: 0;
    background: radial-gradient(circle, currentColor 0 0.3125rem, transparent 0.375rem);
    color: inherit;
    opacity: 0.45;
    text-indent: 0;
    transition: opacity var(--duration-fast) var(--ease-out);
  }

  .quotes__dots [data-bs-slide-to]:hover {
    opacity: 0.8;
  }

  .quotes__dots .active {
    opacity: 1;
    color: var(--color-yellow);
  }

  .quotes__dots [data-bs-slide-to]:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 0;
  }

  .surface-light .quotes__dots .active,
  .surface-subtle .quotes__dots .active {
    color: var(--color-navy);
  }
</style>
