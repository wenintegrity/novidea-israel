# Copy to .env for local builds, or set in Vercel → Settings → Environment Variables.
# Names only; never commit real values (AGENTS.md §4.6). See docs/seo.md §2 and §6.

# The site's final address, without a trailing slash (e.g. https://www.example.co.il).
# Leave empty until the domain is decided: the build then uses the Vercel URL, or localhost.
SITE_URL=

# true = search engines may index the site. Keep false on the temporary vercel.app address and on
# previews; set to true in Vercel's Production environment only once the final domain is live.
ALLOW_INDEXING=false
